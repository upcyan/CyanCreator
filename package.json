{
  "name": "cyancreator",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "ui": "node --test tools/browser-ui.mjs",
    "exceptions": "node --test tools/exception-paths.mjs",
    "trace": "node tools/traceability.mjs",
    "e2e": "node tools/e2e-export.mjs",
    "check": "node --check server.js && node --check lib/transitions.js && node --check lib/core.js && node --check lib/providers.js && node --check lib/coach.js && node --check public/app.js && node --check public/coach.js"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
